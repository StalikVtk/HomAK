<Window x:Class="HomAK.View.WindowEditOperation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.View" xmlns:vm="clr-namespace:HomAK.ViewModels" xmlns:sys="clr-namespace:System;assembly=netstandard"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Изменение операции" Height="410" Width="350">
    <!--<Window.DataContext>
        <vm:EditOperationViewModel/>
    </Window.DataContext>-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <DatePicker Width="150" SelectedDate="{Binding NewDate}" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Тип операции" Margin="5"/>
            <ComboBox Width="200" Margin="5" SelectedItem="{Binding NewType}">
                <sys:String>Приход</sys:String>
                <sys:String>Расход</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Категория" Margin="5"/>
            <ComboBox Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" 
                      DisplayMemberPath="Name" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Счет" Margin="5"/>
            <ComboBox Width="200" ItemsSource="{Binding Counts}" SelectedItem="{Binding NewCount}" 
              DisplayMemberPath="Name" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Сумма" Margin="5"/>
            <TextBox Text="{Binding NewAmount}" Width="150" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <TextBox Text="{Binding NewComment}" Width="315" Height="100" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
            <Button Content="Сохранить" Command="{Binding EditCommand}" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
