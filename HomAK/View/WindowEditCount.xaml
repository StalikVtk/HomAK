<Window x:Class="HomAK.View.WindowEditCount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.View" xmlns:vm="clr-namespace:HomAK.ViewModels"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Изменение счета" Height="205" Width="300">
    <!--<Window.DataContext>
        <vm:EditCountViewModel/>
    </Window.DataContext>-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Наименование" Margin="5"/>
            <TextBox Width="150" Margin="5" Text="{Binding NewNameCount}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Номер" Margin="5"/>
            <TextBox Width="150" Margin="5" Text="{Binding NewNumberCount}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Label Content="Баланс" Margin="5"/>
            <TextBox Width="150" Margin="5" Text="{Binding NewAmountCount}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
            <Button Content="Сохранить" Command="{Binding EditCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
