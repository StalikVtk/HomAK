<Window x:Class="HomAK.View.WindowEditCategory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.View" xmlns:vm="clr-namespace:HomAK.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Изменение категории" Height="200" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Новое название" Margin="5"/>
            <TextBox Width="150" Text="{Binding NewNameCategory}" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
