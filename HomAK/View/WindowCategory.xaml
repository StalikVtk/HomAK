<Window x:Class="HomAK.Resources.ResourcseWindow.WindowCategory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.Resources.ResourcseWindow" xmlns:vm="clr-namespace:HomAK.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Категории" Height="460" Width="300">
    <Window.DataContext>
        <vm:CategoryViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" Height="350" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="5"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox Grid.Row="1" Height="30" Margin="5" Width="65" Text="{Binding NewCategoryName}"/>
            <Button Content="Добавить" Margin="5" Width="60" Height="30" Command="{Binding AddCommand}"/>
            <Button Content="Изменить" Margin="5" Width="60" Height="30" Command="{Binding EditCommand}"/>
            <Button Content="Удалить" Margin="5" Width="60" Height="30" Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</Window>
