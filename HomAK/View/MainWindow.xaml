<Window x:Class="HomAK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HomAK"
        xmlns:local="clr-namespace:HomAK.ViewModels" xmlns:converters="clr-namespace:HomAK.Service" 
            d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="HomAK - Home accounting keeping" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8">
    <Window.Resources>
        <converters:ConverterOperationType x:Key="ConverterOperationType"/>
    </Window.Resources>
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition MinWidth="850"/>
            <ColumnDefinition Width="155"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Menu Grid.ColumnSpan="6" Height="Auto" VerticalAlignment="Center" Background="#646f77" Padding="5">
            <MenuItem Header="Файл">
                <MenuItem Header="Загрузить"></MenuItem>
                <MenuItem Header="Выгрузить"></MenuItem>
                <MenuItem Header="Выход" Click="ExitProgramm"></MenuItem>
            </MenuItem>
            <MenuItem Header="Справочники">
                <MenuItem Header="Счета" Click="MenuItem_Click_Count"></MenuItem>
                <MenuItem Header="Категории" Click="MenuItem_Click_Category">
                </MenuItem>
                <MenuItem Header="Конверты"></MenuItem>
            </MenuItem>
            <MenuItem Header="Отчеты">
                <MenuItem Header="Расходы"></MenuItem>
                <MenuItem Header="Доходы"></MenuItem>
                <MenuItem Header="Счета"></MenuItem>
                <MenuItem Header="Конверты"></MenuItem>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="Шрифт"></MenuItem>
                <MenuItem Header="Фон">
                    <MenuItem Header="Светлый"></MenuItem>
                    <MenuItem Header="Темный"></MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border Grid.Column="0" Grid.Row="2" Grid.RowSpan="2" Background="#b5bdc4" Margin="5,5,5,5" CornerRadius="2">
            <ListBox ItemsSource="{Binding Counts}" Margin="5" Padding="5" SelectedItem="{Binding SelectedCount, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Margin="5"/>
                            <TextBlock Text="{Binding CurrentAmmount, StringFormat='Баланс: {0:C2}', ConverterCulture=ru-RU}" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Border>
        <DataGrid Grid.Column="1" Grid.Row="2" AutoGenerateColumns="False" Padding="5" 
                  Margin="5,5,5,5" ItemsSource="{Binding OperationViewModel.OperationsExpense}"
                  SelectedItem="{Binding SelectedOperation}"
                  GridLinesVisibility="None"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" MinWidth="100" Binding="{Binding DateOperation, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Сумма" Width="150" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="Категория" Width="150" Binding="{Binding Category.Name}"/>
                <DataGridTextColumn Header="Счет" Width="160" Binding="{Binding Count.Number}"/>
                <DataGridTextColumn Header="Вид" Width="100" Binding="{Binding TypeOperation, Converter={StaticResource ConverterOperationType}}"/>
                <DataGridTextColumn Header="Комментарий" Width="150" Binding="{Binding Comment}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Column="1" Grid.Row="3" AutoGenerateColumns="False" Padding="5" 
          Margin="5,5,5,5" ItemsSource="{Binding OperationViewModel.OperationsIncome}"
          SelectedItem="{Binding SelectedOperation}"
          GridLinesVisibility="None"
          IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" MinWidth="100" Binding="{Binding DateOperation, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Сумма" Width="150" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="Категория" Width="150" Binding="{Binding Category.Name}"/>
                <DataGridTextColumn Header="Счет" Width="160" Binding="{Binding Count.Number}"/>
                <DataGridTextColumn Header="Вид" Width="100" Binding="{Binding TypeOperation, Converter={StaticResource ConverterOperationType}}"/>
                <DataGridTextColumn Header="Комментарий" Width="150" Binding="{Binding Comment}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" Margin="5,5,5,5" Background="#b5bdc4" CornerRadius="2">
            <StackPanel Orientation="Vertical" Background="White" HorizontalAlignment="Center" Margin="5">
                <Button Content="Добавить" Margin="5" Command="{Binding AddCommand}" Width="120"/>
                <Button Content="Редактировать" Margin="5" Command="{Binding EditCommand}"/>
                <Button Content="Удалить" Margin="5" Command="{Binding DeleteCommand}"/>
                <Button Content="Отработать" Margin="5"/>
                <Button Content="Фильтр" Margin="5"/>
                <TextBlock Text="{Binding OperationViewModel.SumExpense, StringFormat='Расходы: {0:C2}', ConverterCulture=ru-RU}" Margin="5"/>
                <TextBlock Text="{Binding OperationViewModel.SumIncome, StringFormat='Доходы: {0:C2}', ConverterCulture=ru-RU}" Margin="5"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="6" Background="#646f77" Margin="0,5,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name ="LastMonth" Content="&lt;&lt;" Width="50" Margin="2" Command="{Binding PreviousMonthCommand}"/>
                    <Button x:Name="CurrentMonthBtn" Content="{Binding CurrentMonthName}" Width="100" Margin="2"/>
                    <Button x:Name="NextMonth" Content=">>" Width="50" Margin="2" Command="{Binding NextMonthCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
