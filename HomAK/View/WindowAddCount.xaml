<Window x:Class="HomAK.View.WindowAddCount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.View" xmlns:vm="clr-namespace:HomAK.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Добавить счет" Height="260" Width="320">
    <Window.DataContext>
        <vm:AddCountViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="5">
            <Label Content="Наименивание" Margin="5"/>
            <TextBox Text="{Binding NewCount.Name}" Margin="5" Width="150"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="5">
            <Label Content="Номер" Margin="5"/>
            <TextBox Text="{Binding NewCount.Number}" Margin="5" Width="150"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="5">
            <Label Content="Баланс" Margin="5"/>
            <TextBox Text="{Binding NewCount.Ammount}" Margin="5" Width="150"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"  Margin="5">
            <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Margin="5"/>
            <Button Content="Очистить" Command="{Binding ClearCommand}" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
