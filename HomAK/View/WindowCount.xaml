<Window x:Class="HomAK.Resources.ResourcseWindow.WindowCount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomAK.Resources.ResourcseWindow" xmlns:vm="clr-namespace:HomAK.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#e1e4e8"
        Title="Счета" Height="500" Width="450">
    <Window.DataContext>
        <vm:CountViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" Height="350" ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Number}" Width="170"/>
                        <TextBlock Text="{Binding Name}" Width="100"/>
                        <TextBlock Text="{Binding Ammount, StringFormat='Баланс: {0:C2}', ConverterCulture=ru-RU}" Width="120"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Command="{Binding WindowAddCount}" Width="85" Height="30" Margin="5"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" Width="85" Height="30" Margin="5"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="85" Height="30" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
